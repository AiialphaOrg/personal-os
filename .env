# ===================================================
# Personal OS — Frontend Environment Variables
# ===================================================

# 1. Backend API Endpoint (Points to your Express/Vercel server)
# Local development: http://localhost:4000
# Production: https://your-backend-api.vercel.app
VITE_API_URL=http://localhost:4000

# 2. Neon Auth URL (From Neon Console -> Project -> Auth)
# When provided, "Continue with Google" will use Neon Auth & auto-sync with Neon PostgreSQL.
# Example: https://oauth.neon.tech/api or https://[project-id].neon.tech/auth
VITE_NEON_AUTH_URL=https://ep-bitter-river-au0pioye.neonauth.c-10.us-east-1.aws.neon.tech/neondb/auth

# 3. Google OAuth 2.0 Web Client ID (Optional direct client ID)
# Example: 1234567890-abcdef123456.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
